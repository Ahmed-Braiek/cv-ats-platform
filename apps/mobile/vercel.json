{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "bash scripts/build_web.sh",
  "outputDirectory": "build/web",
  "rewrites": [
    { "source": "/((?!assets/|canvaskit/|icons/|favicon.png|flutter.js|flutter_bootstrap.js|manifest.json|version.json).*)", "destination": "/index.html" }
  ]
}
