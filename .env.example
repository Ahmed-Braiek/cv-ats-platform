# NON-SECRET PLACEHOLDERS ONLY. Copy locally to .env (gitignored).
NODE_ENV=development
PORT=3000
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server only (never expose to Flutter, public frontend, or Git)
SUPABASE_SECRET_KEY=
# Gemini keys: server/worker only. Do not assume distinct keys bypass project-level quotas.
GEMINI_API_KEY_PRIMARY=
GEMINI_API_KEY_SECONDARY=
GEMINI_API_KEY_TERTIARY=
GEMINI_MODEL_OCR=
GEMINI_MODEL_ANALYSIS=
GEMINI_MODEL_FALLBACK=
# Queue / worker configuration (depending on deployment choice)
QUEUE_URL=
